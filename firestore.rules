rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['companyName', 'companyEmail', 'instrumentList', 'calibrationDate', 'expiryDate', 'userId']) &&
             data.companyName is string && data.companyName.size() > 0 &&
             data.companyEmail is string &&
             data.instrumentList is string &&
             data.calibrationDate is timestamp &&
             data.expiryDate is timestamp &&
             data.userId == request.auth.uid &&
             (data.get('contactPerson', '') is string) &&
             (data.get('remindersSent', []) is list);
    }

    match /reports/{reportId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isOwner(existing().userId) && isValidReport(incoming());
      allow delete: if isOwner(existing().userId);
    }
  }
}
